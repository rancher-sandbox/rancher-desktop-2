{
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "preserveSymlinks": true,
    "typeRoots": [
      "../../node_modules",
      "../../shell/types",
      "../../rancher-dashboard/node_modules",
      "../../rancher-dashboard/shell/types"
    ],
    "types": [
      "@types/node",
      "rancher"
    ],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "paths": {
      "@shell/*": [
        "../../shell/*",
        "../../rancher-dashboard/shell/*"
      ],
      "@components/*": [
        "../../pkg/rancher-components/src/components/*",
        "../../rancher-dashboard/pkg/rancher-components/src/components/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    "**/*.vue"
  ],
  "exclude": [
    "../../node_modules"
  ]
}
